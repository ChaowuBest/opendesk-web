+ * See the Mulan PSL v2 for more details.
+ */
+
+import { autoStartupManager, common } from '@kit.AbilityKit';
+import { BusinessError } from '@kit.BasicServicesKit';
+import deviceInfo from '@ohos.deviceInfo';
+
+/** Ordinary apps query their own status; only the user changes the system startup list. */
+export class OpenDeskStartupManager {
+    private nextRequestId: number = 0;
+    private results: Map<number, string> = new Map<number, string>();
+    private expiryTimers: Map<number, number> = new Map<number, number>();
+
+    private resolveContext: () => common.UIAbilityContext | undefined;
+
+    constructor(resolveContext: () => common.UIAbilityContext | undefined) {
+        this.resolveContext = resolveContext;
+    }
+
+    private begin(): number {
+        const id = ++this.nextRequestId;
+        this.results.set(id, '{"status":"pending"}');
+        this.expiryTimers.set(id, setTimeout(() => {
+            this.results.delete(id);
+            this.expiryTimers.delete(id);
+        }, 30000));
+        return id;
+    }
+
+    private finish(id: number, result: string): void {
+        if (this.results.has(id)) this.results.set(id, result);
+    }
+
+    private fail(id: number, error: BusinessError): void {
+        const code = error?.code ?? 16000050;
+        this.finish(id, JSON.stringify({ status: code === 801 ? 'unsupported' : 'error', code: code }));
+    }
+
+    getStatusStart(): number {
+        const id = this.begin();
+        if (deviceInfo.sdkApiVersion < 21) {
+            this.finish(id, '{"status":"unsupported"}');
+            return id;
+        }
+        try {
+            autoStartupManager.getAutoStartupStatusForSelf().then((enabled: boolean) => {
+                this.finish(id, JSON.stringify({ status: 'ok', enabled: enabled }));
+            }).catch((error: BusinessError) => this.fail(id, error));
+        } catch (error) {
+            this.fail(id, error as BusinessError);
+        }
+        return id;
+    }
+
+    openSettingsStart(): number {
+        const id = this.begin();
+        const context = this.resolveContext();
+        if (!context) {
+            this.finish(id, '{"status":"error","code":16000050}');
+            return id;
+        }
+        try {
+            context.startAbility({
+                bundleName: 'com.huawei.hmos.settings',
+                abilityName: 'com.huawei.hmos.settings.MainAbility'
+            }).then(() => this.finish(id, '{"status":"ok"}'))
+                .catch((error: BusinessError) => this.fail(id, error));
+        } catch (error) {
+            this.fail(id, error as BusinessError);
+        }
+        return id;
+    }
+
+    peek(id: number): string {
+        const result = this.results.get(id);
+        if (result === undefined) return '{"status":"error","code":16000050}';
+        if (result !== '{"status":"pending"}') {
+            this.results.delete(id);
+            const timer = this.expiryTimers.get(id);
+            if (timer !== undefined) clearTimeout(timer);
+            this.expiryTimers.delete(id);
+        }
+        return result;
+    }
+}
diff --git a/ohos_hap/tests/opendesk-startup.test.cjs b/ohos_hap/tests/opendesk-startup.test.cjs
new file mode 100644
index 0000000..f69e8fa
--- /dev/null
+++ b/ohos_hap/tests/opendesk-startup.test.cjs
@@ -0,0 +1,64 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const ts = require('typescript');
+const sourcePath = path.join(__dirname, '../web_engine/src/main/ets/adapter/OpenDeskStartupManager.ets');
+function setup(query = async () => true, api = 26) {
+    const requests = [];
+    const auto = { getAutoStartupStatusForSelf: query };
+    const source = fs.readFileSync(sourcePath, 'utf8');
+    const output = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, esModuleInterop: true, target: ts.ScriptTarget.ES2022 } }).outputText;
+    const exports = {};
+    const timers = new Map();
+    let next = 0;
+    vm.runInNewContext(output, { exports, require(name) {
+        if (name === '@kit.AbilityKit') return { autoStartupManager: auto };
+        if (name === '@ohos.deviceInfo') return { sdkApiVersion: api };
+        throw new Error(name);
+    }, setTimeout(fn) { timers.set(++next, fn); return next; }, clearTimeout(id) { timers.delete(id); } });
+    return { service: new exports.OpenDeskStartupManager(() => ({ startAbility: async want => { requests.push(want); } })), requests, timers };
+}
+async function settle() { await new Promise(resolve => setImmediate(resolve)); }
+test('reads system status and consumes completed results once', async () => {
+    const { service, timers } = setup();
+    const id = service.getStatusStart();
+    assert.equal(JSON.parse(service.peek(id)).status, 'pending');
+    await settle();
+    assert.deepEqual(JSON.parse(service.peek(id)), { status: 'ok', enabled: true });
+    assert.equal(JSON.parse(service.peek(id)).status, 'error');
+    assert.equal(timers.size, 0);
+});
+test('isolates overlapping query results by request id', async () => {
+    const resolvers = [];
+    const { service } = setup(() => new Promise(resolve => resolvers.push(resolve)));
+    const a = service.getStatusStart(), b = service.getStatusStart();
+    resolvers[1](true); resolvers[0](false);
+    await settle();
+    assert.equal(JSON.parse(service.peek(a)).enabled, false);
+    assert.equal(JSON.parse(service.peek(b)).enabled, true);
+});
+test('returns unsupported on older SDKs and preserves native errors', async () => {
+    const old = setup(() => { throw Error('must not be called'); }, 20);
+    assert.equal(JSON.parse(old.service.peek(old.service.getStatusStart())).status, 'unsupported');
+    const failed = setup(async () => { throw { code: 16000050 }; });
+    const id = failed.service.getStatusStart(); await settle();
+    assert.deepEqual(JSON.parse(failed.service.peek(id)), { status: 'error', code: 16000050 });
+});
+test('opens only the exported settings ability and never changes a startup list', async () => {
+    const { service, requests } = setup();
+    const id = service.openSettingsStart(); await settle();
+    assert.equal(JSON.parse(service.peek(id)).status, 'ok');
+    assert.equal(requests.length, 1);
+    assert.equal(requests[0].bundleName, 'com.huawei.hmos.settings');
+    assert.equal(requests[0].abilityName, 'com.huawei.hmos.settings.MainAbility');
+});
+test('expires abandoned requests and does not resurrect late responses', async () => {
+    let resolve;
+    const { service, timers } = setup(() => new Promise(r => { resolve = r; }));
+    const id = service.getStatusStart();
+    for (const expire of timers.values()) expire();
+    resolve(true); await settle();
+    assert.equal(JSON.parse(service.peek(id)).status, 'error');
+});
