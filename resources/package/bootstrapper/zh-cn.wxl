<WixLocalization Culture="zh-cn" Language="2052" xmlns="http://schemas.microsoft.com/wix/2006/localization">
    <String Id="Caption">OpenDesk 安装程序</String>
    <String Id="Title">OpenDesk</String>
    <String Id="BrandCopy">把智能工作台带到你的桌面，让模型、文件与自动化任务在一个空间中协同工作。</String>
    <String Id="StepPrepare">准备安装</String>
    <String Id="StepInstall">正在安装</String>
    <String Id="StepComplete">安装完成</String>
    <String Id="InstallEyebrow">版本 [WixBundleVersion] · Windows x64</String>
    <String Id="InstallHeader">欢迎安装 OpenDesk</String>
    <String Id="InstallMessage">安装程序将把 OpenDesk 部署到这台电脑。你可以先在“安装选项”中选择任意本地磁盘。</String>
    <String Id="UpgradeHeader">更新 OpenDesk</String>
    <String Id="UpgradeMessage">检测到已安装的旧版本。安装程序将保留当前安装位置和快捷方式选项并完成更新。</String>
    <String Id="InstallVersion">OpenDesk [WixBundleVersion] · Windows x64</String>
    <String Id="InstallLocationPreview">可在“安装选项”中查看或更改安装路径。</String>
