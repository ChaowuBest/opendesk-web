    <String Id="OptionsLocationLabel">安装位置：</String>
    <String Id="OptionsDriveHint">例如：E:\OpenDesk。安装前会由 Windows Installer 校验磁盘与目录权限。</String>
    <String Id="FolderBrowseDescription">选择 OpenDesk 的安装文件夹</String>
