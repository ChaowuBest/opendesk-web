<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Bundle Name="OpenDesk"
            Version="$(var.BundleVersion)"
            Manufacturer="OpenDesk Team, Openharmony"
            UpgradeCode="e7b412c3-02cc-4ed8-9fcb-5d33fe3390e4"
            IconSourceFile="$(var.IconPath)"
            Compressed="yes">
        <WixVariable Id="WixMbaPrereqPackageId" Value="" />
        <WixVariable Id="WixMbaPrereqLicenseUrl" Value="" />
        <BootstrapperApplicationRef Id="ManagedBootstrapperApplicationHost">
            <Payload SourceFile="$(var.BootstrapperApplicationPath)" Name="OpenDesk.Bootstrapper.dll" />
            <Payload SourceFile="$(var.BootstrapperConfigPath)" Name="BootstrapperCore.config" />
            <Payload SourceFile="$(var.BackgroundPath)" Name="background.png" />
            <Payload SourceFile="$(var.IconPath)" Name="opendesk.ico" />
            <Payload SourceFile="$(var.LocalizationPath)" Name="zh-cn.wxl" />
        </BootstrapperApplicationRef>

        <Variable Name="InstallFolder"
                  Type="string"
                  Value="[ProgramFiles64Folder]opendesk"
                  bal:Overridable="yes" />
        <Variable Name="CreateDesktopShortcut" Type="numeric" Value="1" bal:Overridable="yes" />
        <Variable Name="CreateStartMenuShortcut" Type="numeric" Value="1" bal:Overridable="yes" />
        <Variable Name="InstallPathCustomized" Type="numeric" Value="0" bal:Overridable="yes" />
        <util:RegistrySearch Id="FindPreviousInstallFolder"
                             Variable="PreviousInstallFolder"
                             Root="HKLM"
                             Key="SOFTWARE\OpenDesk\Installer"
                             Value="InstallPath"
                             Result="value"
                             Format="raw"
                             Win64="yes" />
        <util:RegistrySearch Id="RestorePreviousInstallFolder"
                             Variable="InstallFolder"
                             Condition="PreviousInstallFolder"
                             After="FindPreviousInstallFolder"
                             Root="HKLM"
                             Key="SOFTWARE\OpenDesk\Installer"
                             Value="InstallPath"
                             Result="value"
                             Format="raw"
                             Win64="yes" />

        <Chain>
            <MsiPackage Id="OpenDeskMsi"
                        SourceFile="$(var.MsiPath)"
                        DisplayInternalUI="no"
                        Visible="no"
                        Vital="yes">
                <MsiProperty Name="APPLICATIONROOTDIRECTORY" Value="[InstallFolder]" />
                <MsiProperty Name="CREATE_DESKTOP_SHORTCUT" Value="[CreateDesktopShortcut]" />
                <MsiProperty Name="CREATE_START_MENU_SHORTCUT" Value="[CreateStartMenuShortcut]" />
                <MsiProperty Name="INSTALL_PATH_CUSTOMIZED" Value="[InstallPathCustomized]" />
                <MsiProperty Name="OPENDESK_BUNDLE_INSTALL" Value="1" />
            </MsiPackage>
        </Chain>
    </Bundle>
</Wix>
