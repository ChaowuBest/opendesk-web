{
    "schemaVersion": 1,
    "purpose": "pi-tui dependency upgrade specialized test matrix",
    "specializedRoot": "src/tests/pi-tui-migration",
    "regularMatrixPolicy": {
        "isolatedByDefault": true,
        "regularMatrixMigrationRequiresAssessment": true,
        "assessmentFile": "docs/reports/pi_tui_migration_inventory/20260706/test_matrix_migration_assessment.md"
    },
    "gates": {
        "gate0": "inventory and replacement-map status",
        "gate1": "static package/import/mock/documentation migration",
        "gate2": "build and command gate",
        "gate3": "API and keybinding contract",
        "gate4": "TUI component and prompt/focus behavior",
        "gate5": "application-level TUI behavior",
        "gate6": "rendering and real terminal behavior",
        "gate7": "intermittent crash regression retest"
    },
    "rules": {
        "autocomplete-item": { "gates": ["gate3", "gate4"], "risk": "low", "mode": ["contract", "behavior"] },
        "autocomplete-provider": { "gates": ["gate3", "gate4"], "risk": "medium", "mode": ["contract", "behavior"] },
        "box-component": { "gates": ["gate4", "gate6"], "risk": "medium", "mode": ["behavior", "rendering"] },
        "combined-autocomplete-provider": {
            "gates": ["gate3", "gate4"],
            "risk": "medium",
            "mode": ["contract", "behavior"]
        },
        "component-interface": { "gates": ["gate2", "gate4"], "risk": "medium", "mode": ["compile", "behavior"] },
        "editor-component": {
            "gates": ["gate3", "gate4", "gate6"],
            "risk": "high",
            "mode": ["contract", "behavior", "terminal"]
        },
        "editor-theme": { "gates": ["gate2"], "risk": "low", "mode": ["compile"] },
        "focusable-interface": { "gates": ["gate4"], "risk": "medium", "mode": ["behavior"] },
        "input-component": { "gates": ["gate3", "gate4"], "risk": "high", "mode": ["contract", "behavior"] },
        "key-helper": { "gates": ["gate3", "gate6"], "risk": "high", "mode": ["keybinding", "terminal"] },
        "key-id-type": { "gates": ["gate3", "gate6"], "risk": "high", "mode": ["keybinding", "terminal"] },
        "loader-component": { "gates": ["gate4"], "risk": "low", "mode": ["behavior"] },
        "markdown-component": { "gates": ["gate6"], "risk": "low", "mode": ["rendering"] },
        "markdown-theme": { "gates": ["gate2"], "risk": "low", "mode": ["compile"] },
        "overlay-handle": { "gates": ["gate4"], "risk": "medium", "mode": ["behavior"] },
        "process-terminal": { "gates": ["gate6"], "risk": "medium", "mode": ["terminal"] },
        "select-item-type": { "gates": ["gate2"], "risk": "low", "mode": ["compile"] },
        "select-list-component": {
            "gates": ["gate3", "gate4", "gate5"],
            "risk": "high",
            "mode": ["contract", "behavior", "application-tui"]
        },
        "select-list-theme": { "gates": ["gate2"], "risk": "low", "mode": ["compile"] },
        "slash-command-type": { "gates": ["gate3", "gate4"], "risk": "medium", "mode": ["contract", "behavior"] },
        "tui-class": {
            "gates": ["gate4", "gate5", "gate6"],
            "risk": "high",
            "mode": ["behavior", "application-tui", "terminal"]
        },
        "terminal-type": { "gates": ["gate2", "gate6"], "risk": "medium", "mode": ["compile", "terminal"] },
        "text-component": { "gates": ["gate4", "gate6"], "risk": "medium", "mode": ["behavior", "rendering"] },
        "is-key-release": { "gates": ["gate3", "gate5"], "risk": "high", "mode": ["keybinding", "application-tui"] },
        "matches-key": { "gates": ["gate3", "gate5"], "risk": "high", "mode": ["keybinding", "application-tui"] },
        "parse-key": { "gates": ["gate3", "gate6"], "risk": "high", "mode": ["keybinding", "terminal"] },
        "package-scope-import": { "gates": ["gate0", "gate1"], "risk": "low", "mode": ["static"] },
        "editor-keybindings-manager": { "gates": ["gate3"], "risk": "high", "mode": ["keybinding"] },
        "get-editor-keybindings": { "gates": ["gate3", "gate4"], "risk": "high", "mode": ["keybinding", "behavior"] },
        "set-editor-keybindings": { "gates": ["gate3", "gate4"], "risk": "high", "mode": ["keybinding", "behavior"] },
        "action-delete-char-backward": {
            "gates": ["gate3", "gate6"],
            "risk": "high",
            "mode": ["keybinding", "terminal"]
        },
        "action-select-up": {
            "gates": ["gate3", "gate4", "gate5"],
            "risk": "medium",
            "mode": ["keybinding", "behavior", "application-tui"]
        },
        "action-select-down": {
            "gates": ["gate3", "gate4", "gate5"],
            "risk": "medium",
            "mode": ["keybinding", "behavior", "application-tui"]
        },
        "action-select-page-up": {
            "gates": ["gate3", "gate4", "gate5"],
            "risk": "medium",
            "mode": ["keybinding", "behavior", "application-tui"]
        },
        "action-select-page-down": {
            "gates": ["gate3", "gate4", "gate5"],
            "risk": "medium",
            "mode": ["keybinding", "behavior", "application-tui"]
        },
        "action-select-confirm": {
            "gates": ["gate3", "gate4", "gate5"],
            "risk": "high",
            "mode": ["keybinding", "behavior", "application-tui"]
        },
        "action-select-cancel": {
            "gates": ["gate3", "gate4", "gate5"],
            "risk": "high",
            "mode": ["keybinding", "behavior", "application-tui"]
        },
        "action-input-newline": {
            "gates": ["gate3", "gate4", "gate6"],
            "risk": "high",
            "mode": ["keybinding", "behavior", "terminal"]
        },
        "action-input-submit": { "gates": ["gate3", "gate4"], "risk": "high", "mode": ["keybinding", "behavior"] },
        "action-input-tab": { "gates": ["gate3", "gate4"], "risk": "medium", "mode": ["keybinding", "behavior"] },
        "rendering-utils": { "gates": ["gate6"], "risk": "medium", "mode": ["rendering"] },
        "overlay-focus": { "gates": ["gate4"], "risk": "medium", "mode": ["behavior"] },
        "jest-mocks": {
            "gates": ["gate1", "gate2", "gate3"],
            "risk": "medium",
            "mode": ["static", "test-support", "keybinding"]
        },
        "documentation-references": { "gates": ["gate1"], "risk": "low", "mode": ["static"] }
    }
}
