{
    "schemaVersion": 1,
    "purpose": "PL-requested pi-tui post-migration acceptance scenarios",
    "requiredResultStatus": "passed",
    "resultFiles": {
        "fakeModel": "docs/reports/pi_tui_migration_pl_review/artifacts/pl_acceptance_fake_model.json",
        "realModel": "docs/reports/pi_tui_migration_pl_review/artifacts/pl_acceptance_real_model.json"
    },
    "scenarios": [
        {
            "id": "pl-complex-task-streaming-resize",
            "category": "complex-task-ui-and-resize",
            "modes": ["fake", "real"],
            "requiresModelCompletion": true,
            "entrypoints": [
                "src/main/tui/entry.ts",
                "src/main/tui/components/taskview.ts",
                "src/main/tui/components/input.ts",
                "src/main/tui/terminal.ts"
            ],
            "assertions": [
                "A complex streamed task renders markdown, CJK text, code, lists, and the task status bar.",
                "Dynamic terminal resize during streaming does not crash the TUI.",
                "Input remains usable enough for controlled test shutdown after rendering evidence is captured."
            ],
            "automation": {
                "size": { "cols": 120, "rows": 30 },
                "timeoutMs": 18000,
                "allowControlledTermination": true,
                "command": "Run the pi-tui PL acceptance task. Keep the response concise but include a heading, a Chinese paragraph, a list, a table, and a TypeScript code block.",
                "expect": ["PL Fake Model Complex Task", "PL_FAKE_COMPLEX_TASK_DONE", "Tokens:"],
                "reject": ["OpenDesk FATAL", "uncaughtException", "unhandledRejection"],
                "resizeSteps": [
                    {
                        "waitMs": 1400,
                        "cols": 80,
                        "rows": 24,
                        "expectDebugPattern": "terminal width changed .* -> 80"
                    },
                    {
                        "waitMs": 900,
                        "cols": 160,
                        "rows": 40,
                        "expectDebugPattern": "terminal width changed .* -> 160"
                    },
                    {
                        "waitMs": 900,
                        "cols": 60,
                        "rows": 18,
                        "expectDebugPattern": "terminal width changed .* -> 60"
                    },
                    {
                        "waitMs": 900,
                        "cols": 120,
                        "rows": 30,
                        "expectDebugPattern": "terminal width changed .* -> 120"
                    }
                ],
                "input": [{ "waitMs": 12000 }]
            }
        },
        {
            "id": "pl-slash-command-and-skill-autocomplete",
            "category": "slash-autocomplete",
            "modes": ["fake"],
            "entrypoints": [
                "src/main/tui/components/input.ts",
                "src/main/tui/commands/index.ts",
                "src/main/applications/skillmgr/app.ts"
            ],
            "assertions": [
                "Line-start /command completion can be triggered and accepted.",
                "Line-start /skillname completion can be triggered from a deterministic local skill fixture.",
                "Inline /skillname completion can be triggered without corrupting surrounding text."
            ],
            "automation": {
                "size": { "cols": 120, "rows": 30 },
                "timeoutMs": 15000,
                "expect": ["Current workspace", "/pl-smoke-skill", "use /pl-smoke-skill"],
                "reject": ["OpenDesk FATAL", "uncaughtException", "unhandledRejection"],
                "input": [
                    { "waitMs": 2500 },
                    { "text": "/dash" },
                    { "waitMs": 600 },
                    { "key": "tab" },
                    { "waitMs": 400 },
                    { "key": "escape" },
                    { "key": "ctrl-c" },
                    { "text": "/pl-smoke" },
                    { "waitMs": 600 },
                    { "key": "tab" },
                    { "waitMs": 500 },
                    { "key": "ctrl-c" },
                    { "text": "use /pl-smoke" },
                    { "waitMs": 600 },
                    { "key": "tab" },
                    { "waitMs": 500 },
                    { "key": "ctrl-c" },
                    { "text": "/quit" },
                    { "key": "enter" },
                    { "waitMs": 700 },
                    { "key": "enter" }
                ]
            }
        },
        {
            "id": "pl-shortcuts-and-overlay-focus",
            "category": "shortcut-and-focus",
            "modes": ["fake"],
            "entrypoints": [
                "src/main/tui/entry.ts",
                "src/main/tui/shortcuts.ts",
                "src/main/tui/components/input.ts",
                "src/main/tui/components/taskswitcher.ts"
            ],
            "assertions": [
                "Main input editor handles cursor, deletion, newline, submit, tab, and shift-tab shortcuts.",
                "Global help/task/mode shortcuts open or switch without losing focus.",
                "Overlay navigation keys can move, confirm, cancel, and restore input focus."
            ],
            "automation": {
                "size": { "cols": 120, "rows": 30 },
                "timeoutMs": 15000,
                "allowControlledTermination": true,
                "expect": ["Current workspace", "Ctrl+K", "Ctrl+H"],
                "reject": ["OpenDesk FATAL", "uncaughtException", "unhandledRejection"],
                "input": [
                    { "waitMs": 2500 },
                    { "text": "abcdef" },
                    { "key": "left" },
                    { "key": "left" },
                    { "key": "right" },
                    { "key": "backspace" },
                    { "key": "ctrl-backspace" },
                    { "key": "ctrl-j" },
                    { "text": "second line" },
                    { "key": "shift-enter" },
                    { "text": "third line" },
                    { "key": "tab" },
                    { "key": "shift-tab" },
                    { "key": "ctrl-c" },
                    { "key": "ctrl-h" },
                    { "waitMs": 700 },
                    { "key": "escape" },
                    { "key": "ctrl-l" },
                    { "waitMs": 700 },
                    { "key": "down" },
                    { "key": "up" },
                    { "key": "page-down" },
                    { "key": "page-up" },
                    { "key": "escape" },
                    { "key": "ctrl-k" },
                    { "waitMs": 400 },
                    { "key": "ctrl-k" },
                    { "waitMs": 400 },
                    { "text": "/quit" },
                    { "key": "enter" },
                    { "waitMs": 700 },
                    { "key": "enter" }
                ]
            }
        }
    ]
}
