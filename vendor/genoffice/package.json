    "@genoffice/i18n": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/project-store": "*",
    "@genoffice/ui": "*",
    "@genspark/cli": "^1.5.0",
    "acorn": "8.16.0",
    "bidi-js": "^1.0.3",
    "fast-xml-parser": "^5.10.1",
    "harfbuzzjs": "^1.5.0",
    "jszip": "^3.10.1",
    "konva": "^9.3.22",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "^5.7.284",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
