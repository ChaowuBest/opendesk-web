{
  "name": "@opendesk/genoffice-slides",
  "version": "0.1.0",
  "description": "Embeddable GenOffice Slides editor integration for Electron-compatible hosts",
  "license": "(MulanPSL-2.0 AND Apache-2.0)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./dist/main.js",
    "./preload": "./src/preload.ts",
    "./renderer": "./src/renderer.ts",
    "./vite": "./src/vite.ts",
    "./hap": "./src/hap.cjs",
    "./engine": "./packages/pptx-engine/src/index.ts",
    "./hap-manifest": "./hap-manifest.json"
