diff -ruN a/src/reply.rs b/src/reply.rs
--- a/src/reply.rs	2026-09-26 23:38:01.536738941 +0800
+++ b/src/reply.rs	2026-09-26 23:38:01.537976348 +0800
@@ -176,18 +176,40 @@
 impl ReplyEntry {
     /// Reply to a request with the given entry
     pub fn entry(self, ttl: &Duration, attr: &FileAttr, generation: u64) {
+        self.entry_ex(ttl, ttl, attr, generation);
+    }
+
+    /// OpenDesk patch: 分离 entry_timeout（dentry/negative 缓存）与 attr_timeout
+    /// （文件属性缓存）。entry=0 保证"创建后立即读"一致（git 的 lock+rename 不命中
+    /// negative 缓存），attr>0 让 stat 走内核缓存（性能回升）。
+    pub fn entry_ex(self, entry_ttl: &Duration, attr_ttl: &Duration, attr: &FileAttr, generation: u64) {
         self.reply.send_ll(&ll::Response::new_entry(
             ll::INodeNo(attr.ino),
             ll::Generation(generation),
             &attr.into(),
-            *ttl,
-            *ttl,
+            *attr_ttl,
+            *entry_ttl,
         ));
     }

     /// Reply to a request with the given error code
-    pub fn error(self, err: c_int) {
-        self.reply.error(err);
+    ///
+    /// OpenDesk patch: lookup 失败时发送 nodeid=0 且 entry_valid=0 的 entry 回复，
+    /// 内核将 dentry 标为 negative 且立即失效（不缓存）。否则 <1s 内先创建后读取
+    /// 的文件会命中内核 negative dentry 缓存而不可见（如 git init 的 .git/config）。
+    pub fn error(self, err: c_int) {
+        let _ = err;
+        // nodeid=0 且 entry/attr 有效期为 0：内核标为 negative dentry 且立即失效
+        let attr = crate::ll::reply::Attr {
+            attr: unsafe { std::mem::zeroed() },
+        };
+        self.reply.send_ll(&ll::Response::new_entry(
+            ll::INodeNo(0),
+            ll::Generation(0),
+            &attr,
+            Duration::ZERO,
+            Duration::ZERO,
+        ));
     }
 }

