native/windows/sandbox/_setup/
native/windows/sandbox/runtime/
native/windows/sandbox/dist/
native/windows/sandbox/**/bin/
native/windows/sandbox/**/obj/
native/windows/sandbox/src/build/

# Nuxt.js build / generate output
.nuxt
dist
.output

