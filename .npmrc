# 所有 npm 生命周期脚本（npm run / npm install）会自动把该值注入 NODE_OPTIONS 环境变量，
# 替代原 package.json 各平台脚本中重复的 export/set 前缀。
# Rollup/esbuild 压缩大 chunk 需要 8GB 堆（见 scripts/make-arm64-setup.mjs）。
node-options=--max-old-space-size=8192

# npm 12+ 默认禁止拉取 git 依赖和按 resolved URL 直接拉取的 tarball，需要显式放行：
# allow-git：@electron/rebuild 依赖 @electron/node-gyp 的 git 仓库版本（否则报 EALLOWGIT）
# allow-remote：@tailwindcss/oxide-wasm32-wasi 等 bundleDependencies 包按 URL 拉取（否则报 EALLOWREMOTE）
allow-git=all
allow-remote=all
