{
    "name": "opendesk",
    "version": "0.3.5",
    "description": "An all-in-one ai studio for productivity scenarios",
    "license": "MulanPSL-2.0",
    "author": "uv0xab",
    "type": "module",
    "main": "./dist/main/main.js",
    "private": true,
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "start": "npm run build:plugins && run-script-os",
        "start:win32": "chcp 65001 && electron-vite dev",
        "start:darwin": "node scripts/build-darwin-speech-helper.cjs && electron-vite dev",
        "start:linux": "electron-vite dev -- --no-sandbox",
        "preview": "run-script-os",
        "preview:win32": "chcp 65001 && electron-vite preview",
        "preview:darwin": "npm run build && node scripts/build-darwin-speech-helper.cjs && electron-vite preview",
        "preview:linux": "npm run build && electron-vite preview -- --no-sandbox",
        "build": "npm run build:plugins && electron-vite build",
        "build:plugin-sdk": "npm --prefix packages/plugin-sdk run build",
        "build:plugins": "npm run build:plugin-sdk && tsx scripts/build-builtin-plugins.ts",
        "generate:wix-assets": "node scripts/generate-wix-installer-assets.mjs",
        "make:wix-bootstrapper": "node scripts/build-wix-bootstrapper.mjs",
        "stage:ohos-office": "node scripts/stage-opendesk-office-ohos.cjs",
        "package": "run-script-os",
        "package:win32": "npm run build && electron-forge package --platform=win32",
        "package:darwin": "npm run build && node scripts/build-darwin-speech-helper.cjs && electron-forge package --platform=darwin",
        "package:linux": "npm run build && electron-forge package --platform=linux",
        "make": "run-script-os",
        "make:win32": "npm run build && electron-forge make --platform=win32",
        "make:win32:setup": "npm run make:win32 && npm run make:wix-bootstrapper",
        "make:darwin": "npm run build && node scripts/build-darwin-speech-helper.cjs && electron-forge make --platform=darwin",
        "make:linux": "npm run build && electron-forge make --platform=linux",
        "build-cli": "npm run build:plugins && tsx esbuild.config.ts",
        "build-cli-bun": "bun build --compile --minify-whitespace --sourcemap src/main/cli.ts --outfile dist/cli/opendesk-bun --external node-screenshots --external esbuild",
        "cli": "npm run build-cli && node --no-warnings --enable-source-maps dist/cli/opendesk-debug",
        "postinstall": "node scripts/setup-native-modules.cjs",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
        "test:search": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects search",
        "test:node": "tsx --test \"src/tests/ut/node/**/*.test.js\" \"src/tests/ut/node/**/*.test.ts\"",
        "test:workflow": "tsx --test \"src/tests/ut/node/workflow/**/*.test.ts\"",
        "test:acp": "node scripts/acp-smoke-test.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:architecture": "node scripts/check-architecture.cjs",
        "check:docs": "tsx scripts/docs-freshness/docs-freshness.ts",
        "changelog": "node scripts/collect-changelog.js",
        "version": "node scripts/sync-version.mjs",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,ts,mjs,cjs,jsx,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css,scss,yaml,yml,html}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@bitclub.ai/opendesk-office": "0.3.3",
        "@electron-forge/cli": "^7.10.2",
        "@electron-forge/maker-deb": "^7.10.2",
