        "@electron/fuses": "^1.8.0",
        "@eslint/js": "^9.39.2",
        "@playwright/test": "^1.61.1",
        "@types/adm-zip": "^0.5.7",
        "@types/better-sqlite3": "^7.6.13",
        "@types/diff": "^7.0.2",
