        "alpinejs": "^3.15.4",
        "ansi-to-html": "^0.7.2",
        "async-mutex": "^0.5.0",
        "autoprefixer": "^10.4.23",
        "chardet": "^2.1.1",
        "commander": "^14.0.3",
        "croner": "^10.0.1",
        "crypto-js": "^4.2.0",
        "dhash": "^0.0.4",
        "diff": "^8.0.3",
        "dotenv": "^17.3.1",
        "fast-glob": "^3.3.3",
        "file-type": "^16.5.4",
        "highlight.js": "^11.11.1",
        "hnsw": "^1.1.1",
        "hono": "^4.12.21",
        "iconv-lite": "^0.7.2",
        "jieba-wasm": "^2.4.0",
        "jsonrepair": "^3.13.2",
        "katex": "^0.16.27",
        "linkedom": "^0.18.12",
        "llm-chunk": "0.0.1",
        "lxgw-wenkai-screen-webfont": "^1.7.0",
        "mailparser": "^3.9.1",
        "marked": "^17.0.1",
        "marked-highlight": "^2.2.3",
        "marked-katex-extension": "^5.1.6",
        "monaco-editor": "^0.55.1",
        "nedb": "^1.8.0",
        "nedb-promises": "^6.2.3",
        "node-imap": "^0.9.6",
        "node-pop3": "^0.11.0",
        "node-screenshots": "^0.2.1",
        "node-sqlite3-wasm": "^0.8.55",
        "nodemailer": "^8.0.1",
        "officeparser": "^5.2.2",
        "open": "^11.0.0",
        "openai": "^6.10.0",
        "p-map": "^4.0.0",
        "p-queue": "^9.0.1",
        "pdf-lib": "^1.17.1",
        "pdfkit": "^0.17.2",
        "picomatch": "^4.0.4",
        "postcss": "^8.5.6",
        "proper-lockfile": "^4.1.2",
        "punycode": "^2.3.1",
        "qrcode-terminal": "^0.12.0",
        "sharp": "^0.34.5",
        "ssim.js": "^3.5.0",
        "string-template": "^1.0.0",
        "sweetalert2": "^11.15.10",
        "tailwindcss": "^4.1.18",
        "term-size": "^3.0.2",
        "tinymce": "^7.0.0",
        "tinymce-i18n": "^26.1.12",
        "turndown": "^7.2.2",
        "unpdf": "^1.4.0",
        "vectra": "^0.11.1",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0",
        "ws": "^8.20.0",
        "xlsx": "^0.18.5",
        "xml2js": "^0.6.2",
        "yaml": "^2.8.2",
        "yauzl": "^2.10.0",
        "zod": "^4.2.1"
    },
    "optionalDependencies": {
        "@node-rs/jieba": "^2.0.1",
        "better-sqlite3": "^12.6.2",
        "search-index": "^6.0.1",
        "sqlite-vec": "^0.1.7-alpha.2"
    }
}
