{
  "name": "fillipdesk",
  "version": "0.1.3",
  "description": "An all-in-one ai studio for productivity scenarios",
  "license": "BSD-3-Clause",
  "author": "uv0xab",
  "type": "module",
  "main": "./dist/main/main.js",
  "private": true,
  "scripts": {
    "start": "run-script-os",
    "start:win32": "chcp 65001 && electron-vite dev",
    "start:darwin": "electron-vite dev",
    "build": "electron-vite build",
    "package": "run-script-os",
    "package:win32": "npm run build && electron-forge package --platform=win32",
    "package:darwin": "npm run build && electron-forge package --platform=darwin",
    "make": "run-script-os",
    "make:win32": "electron-forge make --skip-package --platform=win32",
    "make:darwin": "electron-forge make --skip-package --platform=darwin",
    "updater:server": "tsx src/updater/server.ts",
    "updater:publish": "tsx src/updater/publish-update.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-wix": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.2",
    "electron": "^39.2.6",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "run-script-os": "^1.1.6",
    "tsx": "^4.21.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.7",
    "@a2ui/lit": "^0.8.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@yaireo/tagify": "^4.31.3",
    "alpinejs": "^3.15.4",
    "ansi-to-html": "^0.7.2",
    "autoprefixer": "^10.4.23",
    "electron-squirrel-startup": "^1.0.1",
    "exa-js": "^2.0.12",
    "fast-glob": "^3.3.3",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.2",
    "jsonrepair": "^3.13.2",
    "katex": "^0.16.27",
    "lodash": "^4.17.21",
    "mailparser": "^3.9.1",
    "marked": "^17.0.1",
    "marked-highlight": "^2.2.3",
    "marked-katex-extension": "^5.1.6",
    "nedb": "^1.8.0",
    "nedb-promises": "^6.2.3",
    "node-pop3": "^0.11.0",
    "node-screenshots": "^0.2.1",
    "nodemailer": "^7.0.12",
    "officeparser": "^5.2.2",
    "openai": "^6.10.0",
    "p-map": "^4.0.0",
    "p-queue": "^9.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "sweetalert2": "^11.15.10",
    "tailwindcss": "^4.1.18",
    "tinymce": "^7.0.0",
    "vectra": "^0.11.1",
    "winston": "^3.19.0",
    "zod": "^4.2.1"
  }
}
