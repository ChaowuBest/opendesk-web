COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Only add the trailer for normal commits (not merges, squashes, amends, etc.)
if [ -z "$COMMIT_SOURCE" ] || [ "$COMMIT_SOURCE" = "message" ]; then
  # Avoid duplicate trailer (check for exact phrase at start of line)
  if ! grep -q "^Reviewed-by: Husky" "$COMMIT_MSG_FILE"; then
    # Remove trailing empty lines and DOS line endings (portable across macOS/Linux)
    sed 's/\r$//' "$COMMIT_MSG_FILE" | grep -v '^$' > "${COMMIT_MSG_FILE}.tmp" || true
    mv "${COMMIT_MSG_FILE}.tmp" "$COMMIT_MSG_FILE"
    # Add trailer - file already ends with newline from grep -v, just add the line
    printf 'Reviewed-by: Husky 🐺\n' >> "$COMMIT_MSG_FILE"
  fi
fi
