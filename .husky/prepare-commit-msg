#!/usr/bin/env bash

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Only add the trailer for normal commits (not merges, squashes, amends, etc.)
# COMMIT_SOURCE is empty for editor-based commits, "message" for -m/-F commits.

if [ -z "$COMMIT_SOURCE" ] || [ "$COMMIT_SOURCE" = "message" ]; then
  # Normalise CRLF (BSD sed-portable; no -i quirks).
  sed 's/\r$//' "$COMMIT_MSG_FILE" > "${COMMIT_MSG_FILE}.tmp" && mv "${COMMIT_MSG_FILE}.tmp" "$COMMIT_MSG_FILE"

  # git interpret-trailers understands the "subject + blank + body + blank + trailers"
  # convention, so it preserves the subject/body blank line separator and only
  # collapses excess trailing blanks. --if-exists doNothing keeps the operation idempotent.
  git interpret-trailers --in-place \
      --if-exists doNothing \
      --trailer "Reviewed-by: Husky 🐺" \
      "$COMMIT_MSG_FILE"
fi
