{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "types": ["node", "jest"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts", "electron.vite.config.ts", "esbuild.config.ts", "jest.config.ts"],
    "exclude": ["node_modules", "dist", "src/tests", "src/common/embedBrowserUse/__tests__"]
}
