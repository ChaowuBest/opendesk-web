{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022", "DOM"],
        "declaration": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "../..",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "../../src/main/aikernel/types/**/*.ts"]
}
