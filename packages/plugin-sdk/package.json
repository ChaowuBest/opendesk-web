{
    "name": "@bitclub.ai/opendesk-plugin-sdk",
    "version": "0.0.0-sync-with-opendesk",
    "description": "Plugin SDK and package validation tools for OpenDesk",
    "license": "MulanPSL-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package": {
            "types": "./dist/package.d.ts",
            "default": "./dist/package.js"
        }
    },
    "bin": {
        "opendesk-plugin-sdk": "dist/cli.js"
    },
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && rollup -c && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
        "prepack": "npm run build"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "dependencies": {
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^12.1.4",
        "@types/node": "^24.0.0",
        "rollup": "^4.61.1",
        "rollup-plugin-dts": "^6.3.0",
        "tslib": "^2.8.1",
        "typescript": "^5.0.0"
    }
}
