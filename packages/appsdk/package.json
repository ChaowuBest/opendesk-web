{
    "name": "@bitclub.ai/opendesk-appsdk",
    "version": "0.1.0",
    "description": "Application SDK for OpenDesk external apps",
    "license": "MulanPSL-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./renderer": {
            "types": "./dist/renderer.d.ts",
            "default": "./dist/renderer.js"
        },
        "./pack": {
            "default": "./dist/pack.js"
        }
    },
    "bin": {
        "opendesk-appsdk": "./dist/pack.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "prepack": "npm run build"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "dependencies": {
        "adm-zip": "^0.5.16",
        "p-queue": "^9.0.1",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.7",
        "@types/node": "^24.0.0",
        "typescript": "^5.0.0"
    }
}
