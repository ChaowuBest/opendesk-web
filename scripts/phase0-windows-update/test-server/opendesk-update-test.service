[Unit]
Description=OpenDesk update test server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xk
Group=xk
WorkingDirectory=/home/xk/opendesk-update-test-server
ExecStart=/usr/bin/python3 -m http.server 80 --bind 0.0.0.0 --directory /home/xk/opendesk-update-test-server
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
